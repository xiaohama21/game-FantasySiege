config_version=5

[application]
config/name="星灯远征"
config/version="0.1.3.0"
config/icon="res://assets/icon.svg"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/use_custom_user_dir=true
config/custom_user_dir_name="FantasySiege"

[autoload]
UserPrefs="*res://scripts/core/UserPrefs.gd"
GameAudio="*res://scripts/audio/GameAudio.gd"
ProfileStore="*res://scripts/core/ProfileStore.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[fantasy_siege]
visuals/managed_mesh_redraw=true
visuals/frame_group_count=2
visuals/critical_instance_limit=12

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
driver/threads/thread_model=1
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=1
environment/defaults/default_clear_color=Color(0.055, 0.08, 0.15, 1)
